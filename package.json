{
  "name": "@purea/eslint-config",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@10.27.0",
  "description": "Pure Anin ESLint Config",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsdown --clean --dts",
    "dev": "tsdown --watch",
    "lint": "eslint . --ext .ts,.js --fix"
  },
  "keywords": [
    "eslint-config"
  ],
  "peerDependencies": {
    "eslint": "^9.39.1"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "eslint": "^9.39.1",
    "jiti": "^2.6.1",
    "tsdown": "^0.15.12",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint-plugin-import": "^2.31.0",
    "globals": "^16.5.0"
  }
}
